{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "build": {
    "env": {
      "VITE_PUBLIC_URL": "/"
    }
  },
  "crons": [],
  "routes": [
    {
      "src": "/_vercel/insights",
      "status": 200,
      "continue": true
    },
    {
      "src": "/.*",
      "dest": "index.html"
    }
  ]
}