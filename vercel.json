{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "build": {
    "env": {
      "VITE_BUILD_TARGET": "vercel"
    },
    "outputDirectory": "dist"
  },
  "routes": [
    {
      "src": "/_vercel/insights",
      "status": 200,
      "continue": true
    },
    {
      "src": "/.*",
      "dest": "index.html"
    }
  ]
}